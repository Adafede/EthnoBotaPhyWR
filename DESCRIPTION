Package: EthnoBotaPhyWR
Title: Infrastructure for Ethnobotanical and Phytochemical Data Integration with Wikidata
Version: 0.0.0.9001
Authors@R: c(
    person(
        given = "Adriano",
        family = "Rutz",
        email = "adafede@gmail.com",
        role = c("aut", "cre"),
